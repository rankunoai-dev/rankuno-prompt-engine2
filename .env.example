# RankUno Prompt Engine — environment configuration.
# Copy to .env and fill in. Never commit .env. Rotate any key that has ever
# appeared in a script, chat log or screenshot.

# --- Application ------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_LOG_PATH=logs/audit.jsonl

# --- Guardrails -------------------------------------------------------------
GUARDRAILS_ENABLED=true
REQUIRE_APPROVAL_FOR_WRITES=true
REQUIRE_APPROVAL_FOR_SPEND=true
# Hard ceiling on cumulative spend for one process (USD).
MAX_SESSION_SPEND_USD=5.0
# Per-action cap for unattended (scheduled) runs. 0 = unattended runs cannot spend.
UNATTENDED_SPEND_CAP_USD=0

# --- Rate limiting / retries ------------------------------------------------
DEFAULT_REQUESTS_PER_MINUTE=60
DEFAULT_MAX_RETRIES=3
DEFAULT_TIMEOUT_S=30

# --- Circuit breaker (per vendor) --------------------------------------------
# Consecutive transient failures that open a vendor's breaker, and how long it
# stays open before one trial call. While open, calls fail fast at no cost.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_S=120

# --- Call minimisation & throughput ------------------------------------------
# Stop sampling a prompt early once MIN_SAMPLES answers agree on whether the
# client was cited. Saves ~1/3 of engine calls on stable prompts.
ADAPTIVE_SAMPLING=true
MIN_SAMPLES=2
# Parallel engine calls per run.
PIPELINE_MAX_WORKERS=4
# Hard cap on engine calls per run (0 = unlimited).
MAX_ENGINE_CALLS_PER_RUN=0
# Reuse a prompt/engine snapshot captured within this many hours instead of
# calling again (0 = always call). Makes a re-run after a crash free.
REUSE_WITHIN_HOURS=0

# --- AI engine credentials ----------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# --- AI engine models & locale ----------------------------------------------
OPENAI_SEARCH_MODEL=gpt-4o-mini
PERPLEXITY_MODEL=perplexity/sonar
GEMINI_MODEL=gemini-3.6-flash
SERP_GL=us
SERP_HL=en
SERP_LOCATION=United States
# desktop | mobile | tablet — organic ranks differ by device; keep fixed for comparable history.
SERP_DEVICE=desktop
# Each prompt is sampled this many times per engine; the citation *rate* is stored.
SAMPLES_PER_ENGINE=3

# --- Per-call cost estimates (USD) charged to the CostLedger ------------------
COST_OPENAI_SEARCH_CALL_USD=0.03
COST_PERPLEXITY_CALL_USD=0.02
COST_GEMINI_GROUNDED_CALL_USD=0.04
COST_SERPAPI_CALL_USD=0.01
COST_SEMRUSH_UNIT_USD=0.000005

# --- SEO data providers -------------------------------------------------------
# SERP_API_KEY and SERPAPI_KEY are both accepted.
SERP_API_KEY=
AHREFS_API_KEY=
SEMRUSH_API_KEY=
SEMRUSH_DATABASE=us
SEMRUSH_DISPLAY_LIMIT=50
SEMRUSH_MAX_UNITS_PER_RUN=20000

# --- Google (reserved for later phases; unused by the prompt tracker) ---------
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# --- Prompt tracker storage ---------------------------------------------------
TRACKER_DB_PATH=data/prompt_tracker.sqlite
REPORTS_DIR=reports
