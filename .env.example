# RankUno Prompt Engine — environment configuration.
# Copy to .env and fill in. Never commit .env. Rotate any key that has ever
# appeared in a script, chat log or screenshot.

# --- Application ------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_LOG_PATH=logs/audit.jsonl

# --- Control plane server ---------------------------------------------------
# Loopback by default. A container must bind 0.0.0.0; PaaS platforms inject PORT.
HOST=127.0.0.1
PORT=8787
# HTTP Basic credential covering every route except /api/health. Unset locally
# means open (loopback is the guard); in production both are REQUIRED at boot.
CONTROL_PLANE_USER=
CONTROL_PLANE_PASSWORD=
# Per-project owner credentials are set in the UI when a project is created
# (ADR 0019): everyone who can reach the app reads, only the holder writes.
# This optional recovery password (16+ characters) unlocks writes on ANY
# project, for a lost owner password. Leave unset to disable the override.
PROJECT_ADMIN_PASSWORD=

# --- Guardrails -------------------------------------------------------------
GUARDRAILS_ENABLED=true
REQUIRE_APPROVAL_FOR_WRITES=true
REQUIRE_APPROVAL_FOR_SPEND=true
# Hard ceiling on cumulative spend for one process (USD).
MAX_SESSION_SPEND_USD=5.0
# Ceiling on actual spend since 00:00 UTC, read back from the usage ledger, so a
# restart cannot re-arm the budget. Applies alongside the session ceiling.
DAILY_SPEND_CAP_USD=5.0
# Per-action cap for unattended (scheduled) runs. 0 = unattended runs cannot spend.
UNATTENDED_SPEND_CAP_USD=0

# --- Crawler log imports (ADR 0022) -------------------------------------------
# One uploaded access log, measured after decompression (bytes).
CRAWLER_LOG_MAX_BYTES=50000000
# A log posted as JSON text or a JSON array cannot be streamed; keep it small.
CRAWLER_LOG_MAX_JSON_BYTES=2000000
# Aggregated crawler hits older than this are purged; import records are kept.
CRAWLER_LOG_RETENTION_DAYS=400

# --- Rate limiting / retries ------------------------------------------------
DEFAULT_REQUESTS_PER_MINUTE=60
DEFAULT_MAX_RETRIES=3
DEFAULT_TIMEOUT_S=30

# --- Circuit breaker (per vendor) --------------------------------------------
# Consecutive transient failures that open a vendor's breaker, and how long it
# stays open before one trial call. While open, calls fail fast at no cost.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_S=120

# --- Call minimisation & throughput ------------------------------------------
# Stop sampling a prompt early once MIN_SAMPLES answers agree on whether the
# client was cited. Saves ~1/3 of engine calls on stable prompts.
ADAPTIVE_SAMPLING=true
MIN_SAMPLES=2
# Cross-crawl stability (ADR 0025): a prompt x platform pair is judged over its
# newest STABILITY_WINDOW_CRAWLS crawls once it has STABILITY_MIN_CRAWLS. Under a
# project's "save" or "reallocate" policy a stable pair's interval is stretched
# up to STRETCH_MAX times (never past the consolidation window) and, under
# "reallocate", volatile pairs get VOLATILE_BOOST extra samples paid for by the
# calls that stretching saved. The default project policy "fixed" changes nothing.
STABILITY_WINDOW_CRAWLS=4
STABILITY_MIN_CRAWLS=3
STRETCH_MAX=3
VOLATILE_BOOST=2
# Parallel engine calls per run.
PIPELINE_MAX_WORKERS=4
# Hard cap on engine calls per run (0 = unlimited).
MAX_ENGINE_CALLS_PER_RUN=0
# Reuse a prompt/engine snapshot captured within this many hours instead of
# calling again (0 = always call). Makes a re-run after a crash free.
REUSE_WITHIN_HOURS=0

# --- AI engine credentials ----------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
# Sentiment judge (ADR 0021): with the key set, every crawl scores its brand
# mentions (polarity + attributes) with this model, capped per crawl. Zero cap
# disables judging. Cost: a few cents per crawl at Haiku prices.
ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5
SENTIMENT_MAX_SENTENCES_PER_RUN=400
SENTIMENT_BATCH_SIZE=40

# --- Executive reports & alerting (ADR 0024) ---------------------------------
# The PDF's executive summary is written by this model from a computed fact
# sheet and then fact-checked against it; with no ANTHROPIC_API_KEY, or a zero
# ceiling, reports still generate with deterministic prose.
ANTHROPIC_REPORT_MODEL=claude-sonnet-5
REPORT_MAX_SPEND_USD=0.25
COST_ANTHROPIC_REPORT_CALL_USD=0.02
# Generated PDFs are purged after this many days; the report row is kept.
REPORT_RETENTION_DAYS=400
REPORT_LOGO_MAX_BYTES=2000000
# Outbound alerts. A destination is configured per project in the UI (a Slack
# incoming webhook and/or recipients); these are the ceilings that stop a
# flapping metric from spamming a client.
ALERTS_MAX_PER_PROJECT_PER_DAY=5
ALERT_COOLDOWN_HOURS=72
# Email delivery. Leave SMTP_HOST empty to disable email entirely; Slack is
# independent of it. Use an app password, never an account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_TIMEOUT_S=20

# --- AI engine models & locale ----------------------------------------------
OPENAI_SEARCH_MODEL=gpt-4o-mini
PERPLEXITY_MODEL=perplexity/sonar
GEMINI_MODEL=gemini-3.6-flash
SERP_GL=us
SERP_HL=en
SERP_LOCATION=United States
# desktop | mobile | tablet — organic ranks differ by device; keep fixed for comparable history.
SERP_DEVICE=desktop
# Each prompt is sampled this many times per engine; the citation *rate* is stored.
SAMPLES_PER_ENGINE=3

# --- Per-call cost estimates (USD) charged to the CostLedger ------------------
COST_OPENAI_SEARCH_CALL_USD=0.03
COST_PERPLEXITY_CALL_USD=0.02
COST_GEMINI_GROUNDED_CALL_USD=0.04
COST_SERPAPI_CALL_USD=0.01
COST_SEMRUSH_UNIT_USD=0.000005
COST_ANTHROPIC_JUDGE_CALL_USD=0.005

# --- SEO data providers -------------------------------------------------------
# SERP_API_KEY and SERPAPI_KEY are both accepted.
SERP_API_KEY=
AHREFS_API_KEY=
SEMRUSH_API_KEY=
SEMRUSH_DATABASE=us
SEMRUSH_DISPLAY_LIMIT=50
SEMRUSH_MAX_UNITS_PER_RUN=20000

# --- Google (reserved for later phases; unused by the prompt tracker) ---------
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# --- Prompt tracker storage ---------------------------------------------------
# Relative paths resolve against the process working directory. On a host with
# an ephemeral filesystem, point all three at the mounted volume (see below).
TRACKER_DB_PATH=data/prompt_tracker.sqlite
REPORTS_DIR=reports

# --- Railway (or any container host) -----------------------------------------
# Set these as service variables in the dashboard, not in a committed file.
# The Dockerfile runs `python -m src.modules.control_plane --approve-spend`.
# See docs/DEPLOY_RAILWAY.md for the step-by-step.
#
#   ENVIRONMENT=production
#   HOST=0.0.0.0                       # PORT is injected by the platform
#   CONTROL_PLANE_USER=<you>
#   CONTROL_PLANE_PASSWORD=<long random string>
#   MAX_SESSION_SPEND_USD=5.0
#   DAILY_SPEND_CAP_USD=5.0
#   TRACKER_DB_PATH=/data/prompt_tracker.sqlite   # volume mounted at /data
#   REPORTS_DIR=/data/reports
#   AUDIT_LOG_PATH=/data/logs/audit.jsonl
#   OPENAI_API_KEY=... PERPLEXITY_API_KEY=... GEMINI_API_KEY=...
#   SERP_API_KEY=...   SEMRUSH_API_KEY=...
